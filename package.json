    "check": "pnpm --filter demo check",
    "test": "node --test \"tests/*.test.ts\"",
    "grid:audit": "node scripts/grid-audit.mjs",
    "grid:codemod": "node scripts/grid-codemod.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "docs:api:check": "node scripts/gen-api-docs.mjs --check",
